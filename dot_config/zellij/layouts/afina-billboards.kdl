layout {
  default_tab_template {
    pane size=1 {
      borderless true
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 {
      borderless true
      plugin location="zellij:status-bar"
    }
  }
  tab name="editor" cwd="~/projects/afina-billboards" {
    pane
    
  }
  tab name="runner" cwd="~/projects/afina-billboards" {
    pane split_direction="horizontal" {
      pane
      pane split_direction="vertical" {
        pane
        pane
      }
    }
    
  }
  tab name="worker" cwd="~/projects/afina-billboards" {
    pane
  }
}
