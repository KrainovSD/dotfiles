layout {
  default_tab_template {
    pane size=1 {
      borderless true
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 {
      borderless true
      plugin location="zellij:status-bar"
    }
  }
  tab name="k9s" {
    pane command="k9s"
  }
  tab name="resources"{
    pane command="btop"
  }
}
