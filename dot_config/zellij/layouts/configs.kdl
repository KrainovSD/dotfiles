layout {
  default_tab_template {
    pane size=1 {
      borderless true
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 {
      borderless true
      plugin location="zellij:status-bar"
    }
  }
  tab name="nvim" cwd=".config/nvim" {
    pane 
  }
  tab name="zsh" {
    pane 
  }
  tab name="hyprland" cwd=".config/hypr" {
    pane 
  }
  tab name="zellij" cwd=".config/zellij" {
    pane 
  }
  tab name=".local/share/chezmoi" {
    pane 
  }
  tab name="others" {
    pane 
  }
}
