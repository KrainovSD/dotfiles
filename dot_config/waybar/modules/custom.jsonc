{
  "custom/distro": {
    "format": "󰣇",
    "tooltip-format": "Power Menu",
    "on-click": "kitty --class=power-menu -e ~/.config/waybar/scripts/power-menu.sh",
  },

  "group/powermenu": {
    "orientation": "horizontal",
    "modules": ["custom/left_div#5", "custom/distro", "custom/right_div#2"]
  },

  // left dividers
  "custom/left_div#1": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#2": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#3": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#4": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#5": {
    "format": "",
    "tooltip": false,
    "on-click": "kitty --class=power-menu -e ~/.config/waybar/scripts/power-menu.sh",
  },
  "custom/left_div#6": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#7": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_div#8": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_inv#1": {
    "format": "",
    "tooltip": false,
  },
  "custom/left_inv#2": {
    "format": "",
    "tooltip": false,
  },

  // right dividers
  "custom/right_div#1": {
    "format": "",
    "tooltip": false,
  },
  "custom/right_div#2": {
    "format": "",
    "tooltip": false,
    "on-click": "kitty --class=power-menu -e ~/.config/waybar/scripts/power-menu.sh",
  },
  "custom/right_div#3": {
    "format": "",
    "tooltip": false,
  },
  "custom/right_div#4": {
    "format": "",
    "tooltip": false,
  },
  "custom/right_div#5": {
    "format": "",
    "tooltip": false,
  },
  "custom/right_inv#1": {
    "format": "",
    "tooltip": false,
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/notifications.sh list",
    "interval": 5
  },

  "custom/system_update": {
    "exec": "~/.config/waybar/scripts/system-update.sh module",
    "return-type": "json",
    "interval": 3600,
    "format": "{}",
    "min-length": 2,
    "max-length": 2,
    "on-click": "kitty -e ~/.config/waybar/scripts/system-update.sh",
  },

  "group/user": {
    "orientation": "horizontal",
    "modules": ["custom/trigger", "custom/user"],
    "drawer": {},
  },

  "custom/trigger": {
    "format": "󰍜",
    "min-length": 4,
    "max-length": 4,
    "tooltip": false,
  },

  "custom/user": {
    "exec": "id -un",
    "format": "{}",
    "tooltip": false,
  },
}
